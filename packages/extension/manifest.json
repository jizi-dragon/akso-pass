{
  "manifest_version": 3,
  "key": "",
  "name": "Akso Pass · 多账号并行",
  "short_name": "Akso Pass",
  "version": "4.2.4",
  "description": "纯浏览器多账号并行 + 输入框即时翻译：每账号独立标签页与存储命名空间，页签名自定义，账号存云端账号库；Alt+T 取译文到剪贴板。",
  "minimum_chrome_version": "110",
  "commands": {
    "quick-wheel": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "打开账号选择轮盘（可在 chrome://extensions/shortcuts 自定义）"
    },
    "quick-status": {
      "suggested_key": {
        "default": "Alt+W"
      },
      "description": "打开实例状态轮盘（切换当前页签对象实例的生命周期状态）"
    },
    "quick-favorites": {
      "suggested_key": {
        "default": "Alt+1"
      },
      "description": "打开常用页面轮盘（书签直达）"
    },
    "translate-input": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "翻译当前输入框内容并复制到剪贴板（不改动输入框）"
    }
  },
  "icons": {
    "16": "assets/Icon16.png",
    "32": "assets/Icon32.png",
    "48": "assets/Icon48.png",
    "128": "assets/Icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Akso Pass · 多账号并行",
    "default_popup": "ui/popup/popup.html",
    "default_icon": {
      "16": "assets/Icon16.png",
      "32": "assets/Icon32.png",
      "48": "assets/Icon48.png",
      "128": "assets/Icon128.png"
    }
  },
  "permissions": [
    "tabs",
    "scripting",
    "cookies",
    "storage",
    "webRequest",
    "declarativeNetRequestWithHostAccess",
    "webNavigation"
  ],
  "host_permissions": [],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/shield-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/shield-main.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/title-hook.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/auto-login.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/translate.js"
      ],
      "css": [
        "content/translate.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
